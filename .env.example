MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
MICROCMS_ENDPOINT=ghosts

# OpenAI Image API（サーバー側のみ。NEXT_PUBLIC_ は付けない）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=xhigh
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_COMPRESSION=95

# 外部の試着APIを使う場合だけ指定。空欄なら /api/try-on を使用します。
NEXT_PUBLIC_TRY_ON_ENDPOINT=

# TRY THE GHOST（本番は Cloudflare Secrets に設定。詳細は TRY_THE_GHOST_SETUP.md）
# セッションCookieの署名鍵（openssl rand -hex 32 で生成）
SESSION_SECRET=
# IP / User-Agent をハッシュ化するときのソルト（openssl rand -hex 32 で生成）
HASH_SALT=
# 公開URLの origin。LINE Login の callback URL に使う。空欄ならアクセス中のURLから自動判定
APP_ORIGIN=
# LINE Login チャネル
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 任意: 公式LINEの Messaging API チャネルアクセストークン（生成直前に「今も友だちか」を再確認する）
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# 任意: 同一IPからの1時間あたりの生成試行上限（既定 12）
TRY_ON_IP_HOURLY_LIMIT=

# ローカル動作確認用（localhost でのみ有効。本番では設定しても無視される）
# LINE Login を実際に行わず「友だち／友だちではない」を選べるモック
LINE_LOGIN_MOCK=
# OpenAI を呼ばずに参照画像を生成結果として返すモック（回数制限の確認用）
TRY_ON_MOCK_IMAGE=
